    "context-history-rpc-smoke": "node scripts/context-history-rpc-smoke.mjs",
    "wallet-balance-smoke": "node scripts/wallet-balance-smoke.mjs",
    "wallet-transactions-smoke": "node scripts/wallet-transactions-smoke.mjs",
    "eth-deposit-wallet": "node scripts/generate-eth-deposit-wallet.mjs",
    "smoke": "node scripts/smoke.mjs",
    "frame-smoke": "node scripts/frame-smoke.mjs"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "ethers": "^6.16.0",
    "libsodium": "^0.8.4",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ripple-keypairs": "^2.0.0",
    "ws": "^8.19.0",
    "xrpl": "^4.6.0"
