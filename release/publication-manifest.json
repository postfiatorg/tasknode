{
  "schemaVersion": 1,
  "include": [
    ".dockerignore",
    ".editorconfig",
    ".github/**",
    ".gitignore",
    ".gitleaks.toml",
    ".node-version",
    ".npmrc",
    ".nvmrc",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "Dockerfile",
    "Dockerfile.dev",
    "fly.example.toml",
    "fly.worker.example.toml",
    "LICENSE",
