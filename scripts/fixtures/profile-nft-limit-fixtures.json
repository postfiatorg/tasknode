  "sql": {
    "unscoped": "SELECT *\n           FROM profile_nfts\n          WHERE account_id = $1\n            \n            AND profile_nfts.id NOT LIKE 'directory_polish_%'\n    AND COALESCE(profile_nfts.model, '') <> 'directory-polish'\n          ORDER BY created_at DESC NULLS LAST, updated_at DESC NULLS LAST, id DESC\n          LIMIT $2",
    "unscoped_public": "SELECT *\n           FROM profile_nfts\n          WHERE account_id = $1\n            AND lower(status) IN ('minted', 'prepared', 'generated')\n       AND (\n         COALESCE(image_gateway_url, '') <> ''\n         OR COALESCE(image_cid, '') <> ''\n       )\n            AND profile_nfts.id NOT LIKE 'directory_polish_%'\n    AND COALESCE(profile_nfts.model, '') <> 'directory-polish'\n          ORDER BY created_at DESC NULLS LAST, updated_at DESC NULLS LAST, id DESC\n          LIMIT $2",
    "scoped": "SELECT *\n           FROM profile_nfts\n          WHERE account_id = $1\n            AND (\n              wallet_address = $3\n              OR ($4::boolean = true AND wallet_address = '')\n            )\n            \n            AND profile_nfts.id NOT LIKE 'directory_polish_%'\n    AND COALESCE(profile_nfts.model, '') <> 'directory-polish'\n          ORDER BY created_at DESC NULLS LAST, updated_at DESC NULLS LAST, id DESC\n          LIMIT $2",
    "scoped_public": "SELECT *\n           FROM profile_nfts\n          WHERE account_id = $1\n            AND (\n              wallet_address = $3\n              OR ($4::boolean = true AND wallet_address = '')\n            )\n            AND lower(status) IN ('minted', 'prepared', 'generated')\n       AND (\n         COALESCE(image_gateway_url, '') <> ''\n         OR COALESCE(image_cid, '') <> ''\n       )\n            AND profile_nfts.id NOT LIKE 'directory_polish_%'\n    AND COALESCE(profile_nfts.model, '') <> 'directory-polish'\n          ORDER BY created_at DESC NULLS LAST, updated_at DESC NULLS LAST, id DESC\n          LIMIT $2"
  },
